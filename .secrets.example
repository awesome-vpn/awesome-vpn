# GitHub Secrets (for local development)
# Copy to .secrets and fill in values
#
# NOTE: SOURCES_JSON and EXTRA_URLS below are only used as a ONE-TIME SEED.
# On every run they get merged into config/url_sources.json, a self-updating,
# git-tracked ledger (mirrors config/channels.json for Telegram channels).
# Sources that repeatedly yield zero nodes are auto-frozen and later revived;
# editing the ledger file directly (or letting it evolve run-over-run) is the
# ongoing way to manage sources -- you do not need to keep growing this secret.

# Telegram channel sources (comma-separated list of channel handles)
TELEGRAM_CHANNELS=

# Additional URL sources: newline-separated plain URLs (one-time seed only)
EXTRA_URLS=

# Full data sources configuration (JSON format, same schema as config/sources.json.example)
# One-time seed only -- see NOTE above.
SOURCES_JSON={"urls": []}
